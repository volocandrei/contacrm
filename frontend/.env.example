# Configurarea frontend-ului. Copiază în `.env.local` și modifică ce ai nevoie.
# Doar variabilele care încep cu `VITE_` ajung în bundle — deci nu pune niciodată
# un secret aici: fișierul construit este public.

# `mock` = backendul simulat din browser (implicit; nu are nevoie de server).
# `http` = API-ul real.
VITE_API_MODE=mock

# Baza API-ului. Lasă calea relativă: `vite.config.ts` proxy-ază `/api` către
# backend, deci browserul vede o singură origine și cookie-ul de sesiune ajunge și
# la previzualizarea documentelor. O bază absolută pe altă origine rupe preview-ul.
VITE_API_BASE_URL=/api/v1

# Unde ascultă backend-ul, pentru proxy-ul din development.
VITE_PROXY_TARGET=http://127.0.0.1:8000
