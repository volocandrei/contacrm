# Copiază în `.env` și completează local. NU comite niciodată `.env`.
# Valorile de aici sunt exemple pentru development — nu sunt credențiale reale.

# ─── Aplicație ────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
APP_NAME=ContaCRM
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=ro
DEFAULT_TIMEZONE=Europe/Bucharest
LOG_LEVEL=INFO

# ─── Securitate ───────────────────────────────────────────────────────────────
# Generează cu: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=schimba-aceasta-valoare-inainte-de-orice-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_HASH_ALGORITHM=argon2id
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120

# ─── Bază de date ─────────────────────────────────────────────────────────────
POSTGRES_USER=contacrm
POSTGRES_PASSWORD=contacrm_dev_password
POSTGRES_DB=contacrm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://contacrm:contacrm_dev_password@localhost:5432/contacrm
DB_ECHO=false                     # true = loghează fiecare interogare SQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
BACKEND_PORT=8000

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Storage (ADR-004) ────────────────────────────────────────────────────────
STORAGE_PROVIDER=local            # local | s3 | azure_blob | onedrive | gdrive
STORAGE_PATH=./storage
ARCHIVE_ROOT=./storage/ARHIVA
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
# S3 (doar dacă STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# ─── OCR / AI (ADR-005) ───────────────────────────────────────────────────────
# `mock` este implicit în development: niciun document nu părăsește mașina.
OCR_PROVIDER=mock                 # mock | tesseract | google_docai | aws_textract | azure_di
OCR_FALLBACK_PROVIDER=
AI_PROVIDER=mock                  # mock | anthropic | openai | azure_openai
AI_MODEL=
AI_API_KEY=
PROMPT_VERSION=v1
# Praguri implicite; valorile efective se administrează din `system_settings` (§16).
CONFIDENCE_AUTO_THRESHOLD=0.90
CONFIDENCE_REVIEW_THRESHOLD=0.70
# Aprobarea fara verificare umana ramane oprita pana cand cineva o cere explicit.
AUTO_APPROVE_ENABLED=false
MAX_PROCESSING_ATTEMPTS=3
# Dupa cate minute un job ramas RUNNING se considera abandonat de un proces mort.
# `python -m app.cli recover-processing` il repune in coada.
PROCESSING_STALE_AFTER_MINUTES=15

# ─── Email ingestion — Microsoft Graph (Faza 2) ───────────────────────────────
EMAIL_PROVIDER=none               # none | microsoft_graph | imap | gmail
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_MAILBOX=

# ─── WhatsApp (Faza 2) ────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=none            # none | meta | twilio
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Notificări ───────────────────────────────────────────────────────────────
NOTIFICATIONS_ENABLED=false       # implicit oprit: nu trimitem mesaje reale din development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Retenție (§64) ───────────────────────────────────────────────────────────
# Nicio ștergere automată nu rulează fără o regulă explicit activată.
RETENTION_ENABLED=false
RETENTION_DOCUMENTS_YEARS=10
RETENTION_AUDIT_LOG_YEARS=5
RETENTION_TEMP_FILES_DAYS=7

# ─── Observabilitate (opțional) ───────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
