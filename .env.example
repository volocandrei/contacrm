# Copiază în `.env` și completează local. NU comite niciodată `.env`.
# Valorile de aici sunt exemple pentru development — nu sunt credențiale reale.

# ─── Aplicație ────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
APP_NAME=ContaCRM
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=ro
DEFAULT_TIMEZONE=Europe/Bucharest
LOG_LEVEL=INFO

# ─── Securitate ───────────────────────────────────────────────────────────────
# Generează cu: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=schimba-aceasta-valoare-inainte-de-orice-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Algoritmul de hash al parolelor **nu este configurabil**: este argon2id, ales
# in cod (`app/core/security.py`). A existat aici o variabila care parea sa-l
# schimbe si pe care nu o citea nimeni — pusa pe altceva, ar fi lasat pe cineva
# sa creada ca a schimbat o decizie de securitate pe care nu a schimbat-o.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Adresa la care ajunge un om din afara cabinetului: clientul care primeste un
# link de trimitere. Nu se poate deduce din cererea curenta — linkul se compune
# pe server, ajunge intr-un email si trebuie sa functioneze de oriunde.
#
# In productie NU are voie sa ramana pe localhost: pornirea se opreste. Un link
# compus asa ajunge la client si nu duce nicaieri, iar asta se descopera abia
# cand cineva il deschide.
PUBLIC_BASE_URL=http://localhost:5173
# Cate incercari de autentificare accepta o adresa IP intr-un minut, pentru un
# anumit cont, si cate in total peste toate conturile. Zero opreste limitarea.
#
# Aici scria `RATE_LIMIT_PER_MINUTE=120`, pe care nu il citea niciun modul: o
# promisiune de protectie care nu exista nicaieri in cod. Vezi
# `app/core/rate_limit.py` pentru ce acopera contorul si ce nu — pe scurt, sta
# in proces, deci mai multe procese de API inseamna mai multe contoare.
LOGIN_ATTEMPTS_PER_MINUTE=10
LOGIN_ATTEMPTS_PER_ADDRESS_PER_MINUTE=60
# Secretul cu care un planificator extern (cron) poate cere un tur de coada.
# Gol = ruta `/api/v1/internal/run-queue` nu exista. Vezi docs/DEPLOY.md.
CRON_SECRET=
# Cate proxy-uri de incredere stau OBLIGATORIU in fata aplicatiei: 0 cand este
# expusa direct, 1 in spatele Vercel sau al unui reverse proxy. Sub acest numar,
# antetul X-Forwarded-For se ignora: citit fara sa stim cine l-a scris, oricine
# si-ar putea alege ce IP apare in jurnalul de audit.
TRUSTED_PROXY_COUNT=0

# ─── OneDrive / SharePoint (M9) ───────────────────────────────────────────────
# Aplicatia inregistrata in Entra ID prin care se citesc dosarele clientilor.
# Vezi docs/DEPLOY.md pentru pasii de inregistrare. Fara MS_CLIENT_ID, ecranul
# „Surse documente" spune ca integrarea nu este configurata — nu o ofera si apoi
# esueaza.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# `common` accepta orice cont Microsoft. Un cabinet cu tenant propriu pune id-ul
# lui si restrange accesul la propriii utilizatori.
MS_TENANT_ID=common
# Trebuie sa fie IDENTIC cu ce e inregistrat in Entra ID, altfel consimtamantul
# esueaza cu o eroare opaca. In productie: https://<domeniu>/administrare/surse
MS_REDIRECT_URI=http://localhost:5173/administrare/surse
# Cheia cu care se cripteaza refresh tokenul inainte de a atinge baza de date.
# Generata cu:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SEPARATA de SECRET_KEY, deliberat: aceea se roteste dupa o scurgere, iar
# rotirea ei nu are voie sa rupa tacut legaturile cu OneDrive.
DRIVE_TOKEN_KEY=
# Cate fisiere ia un tur de sincronizare, per dosar.
DRIVE_SYNC_BATCH=50
# Cate mesaje ia un tur, per dosar de email. Mai mic decat la drive: fiecare mesaj
# cu atasamente costa inca o cerere pentru metadatele lor.
MAIL_SYNC_BATCH=25

# ─── e-Factura / SPV ANAF (M11) ───────────────────────────────────────────────
# Aplicatia inregistrata in portalul OAuth al ANAF, prin care se preiau facturile
# electronice ale clientilor. Vezi docs/DEPLOY.md. Fara ANAF_CLIENT_ID, ecranul
# „e-Factura" spune ca integrarea nu este configurata — nu o ofera si apoi esueaza.
#
# ATENTIE, doua conditii care NU se rezolva din configurare:
#   1. autorizarea cere certificatul digital calificat inrolat in SPV, prezentat
#      de browser. Se face o data pe an, de la calculatorul cu tokenul USB in port.
#   2. fiecare client trebuie sa depuna imputernicirea in SPV (formular 150)
#      pentru certificatul cabinetului. Fara ea, ANAF nu intoarce eroare —
#      intoarce gol.
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
# Trebuie sa fie IDENTIC cu ce e inregistrat la ANAF.
# In productie: https://<domeniu>/administrare/e-factura
ANAF_REDIRECT_URI=http://localhost:5173/administrare/e-factura
# `prod` lucreaza pe facturile reale, `test` pe mediul de test al ANAF. Sunt baze
# complet separate: un token de test nu vede nimic in productie si invers.
ANAF_ENVIRONMENT=prod
# Cate facturi ia un tur, per client. ANAF limiteaza cererile pe zi.
ANAF_SYNC_BATCH=25
# Cat in urma se uita prima sincronizare a unui client. ANAF nu accepta ferestre
# mai lungi de 60 de zile intr-o singura cerere.
ANAF_LOOKBACK_DAYS=30
# Tokenul ANAF se cripteaza cu aceeasi DRIVE_TOKEN_KEY de mai sus.

# ─── Termenul lunii ───────────────────────────────────────────────────────────
# Ziua din luna URMATOARE pana la care trebuie depuse declaratiile pentru luna
# incheiata. 25 este termenul obisnuit in Romania (D300, D394), dar ramane
# configurabil: un cabinet care isi impune un termen intern mai devreme trebuie
# sa-l poata pune, iar legea se poate schimba fara noi.
# Maximum 28: ziua trebuie sa existe in orice luna, inclusiv februarie.
FILING_DEADLINE_DAY=25

# ─── Bază de date ─────────────────────────────────────────────────────────────
POSTGRES_USER=contacrm
POSTGRES_PASSWORD=contacrm_dev_password
POSTGRES_DB=contacrm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://contacrm:contacrm_dev_password@localhost:5432/contacrm
DB_ECHO=false                     # true = loghează fiecare interogare SQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# `true` cand DATABASE_URL arata catre un pooler in mod tranzactie (PgBouncer,
# Supabase pe :6543). Opreste poolul propriu si instructiunile pregatite — doua
# lucruri pe care un pooler in modul asta le rupe tacut.
DB_EXTERNAL_POOLER=false
BACKEND_PORT=8000

# ─── Coada de procesare ───────────────────────────────────────────────────────
# Nu exista broker. Coada este `document_processing_jobs`, un outbox tranzactional
# in aceeasi baza de date; `python -m app.worker` o consuma. Vezi app/worker.py
# pentru de ce nu Celery + Redis.

# ─── Storage (ADR-004) ────────────────────────────────────────────────────────
STORAGE_PROVIDER=local            # local | s3
STORAGE_PATH=./storage
ARCHIVE_ROOT=./storage/ARHIVA
MAX_UPLOAD_SIZE_MB=25
# application/xml este factura electronica (e-Factura, UBL 2.1) — de la 1 iulie
# 2024 forma obligatorie intre firme, deci majoritatea facturilor unui cabinet.
ALLOWED_MIME_TYPES=application/pdf,application/xml,image/jpeg,image/png,image/webp
# S3 (doar daca STORAGE_PROVIDER=s3). Merge cu orice serviciu compatibil:
# AWS, Supabase Storage, Cloudflare R2, MinIO. Endpoint gol inseamna AWS.
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PREFIX=                        # separa medii care impart un bucket

# ─── OCR / AI (ADR-005) ───────────────────────────────────────────────────────
# Ce implementari exista chiar acum. Un nume neimplementat opreste pornirea, nu
# esueaza abia in worker, la primul document.
#   mock     — date sintetice, deterministe pe hash. Nu citeste nimic.
#              PORNIREA IN PRODUCTIE O REFUZA: inventeaza furnizori, sume si date.
#   pdf_text — citeste stratul de text al PDF-ului. Nu este OCR: un document
#              scanat sau o poza nu au text de citit, iar providerul spune asta
#              in loc sa inventeze.
#   efactura — citeste factura electronica (UBL 2.1). Document structurat: fiecare
#              valoare sta intr-un camp cu nume, deci nu exista nimic de ghicit.
#   local    — alege intre pdf_text si efactura dupa continutul fisierului.
#              VALOAREA POTRIVITA PENTRU UN CABINET REAL: primeste in aceeasi zi
#              si XML-uri, si PDF-uri, iar OCR_PROVIDER este unul singur.
# Cele de mai sus sunt locale: niciun document nu paraseste masina (R2).
#
#   vision   — citeste documentul cu un model care vede imagini. Acopera exact
#              ce nu poate niciun provider local: POZE SI SCANURI. Un document
#              fotografiat nu are strat de text, deci ajungea la verificare cu
#              toate campurile goale — iar poza este chiar ce trimit clientii
#              prin linkul de incarcare.
#   hybrid   — local intai, model doar pentru ce nu s-a putut citi aici.
#              VALOAREA POTRIVITA daca vrei si citirea pozelor: un PDF emis de
#              un ERP se citeste in cabinet, fara retea si fara cheie; pleaca
#              doar pozele.
#
# ATENTIE, DECIZIE DE LUAT CONSTIENT: `vision` si `hybrid` TRIMIT DOCUMENTUL in
# afara cabinetului, la furnizorul modelului. Pentru un cabinet de contabilitate
# asta este o decizie cu implicatii GDPR — verifica ce ai de verificat inainte,
# nu dupa. Implicit ramane `mock`, iar recomandarea pentru productie fara model
# ramane `local`.
#
# Ce nu face modelul, deliberat: nu decide tipul documentului (o factura nu-si
# spune directia; aceea se afla la identificarea clientului) si nu poate declara
# o incredere peste 0.85, deci nu poate impinge singur un document peste pragul
# de aprobare automata. Un contabil se uita oricum.
OCR_PROVIDER=mock                 # mock | pdf_text | efactura | local | vision | hybrid
# Nu exista o variabila de "fallback": lantul este chiar `hybrid` — local intai,
# model doar cand nu e nimic de citit (ADR-005). O a doua variabila ar fi fost
# un al doilea loc din care se decide acelasi lucru.
#
# Al cui este modelul din spatele lui `vision`/`hybrid`. NU alege providerul —
# aceea este `OCR_PROVIDER`; spune al cui este modelul, pentru verificarea de
# consistenta la pornire si pentru ecranul de setari. O valoare necunoscuta
# opreste pornirea, ca la ceilalti provideri: `openai` si `azure_openai` au stat
# aici enumerate ani fara sa existe in cod.
AI_PROVIDER=mock                  # mock | anthropic

# Cheia modelului care CITESTE DOCUMENTELE. Obligatorie pentru `vision` si
# `hybrid`: fara ea, pornirea in productie se opreste — altfel fiecare poza ar
# marca documentul ca esuat, iar asta s-ar observa abia dupa o suta de documente.
#
# Separata de ASSISTANT_API_KEY, si nu din intamplare: sunt doua decizii
# diferite. Un cabinet poate vrea un asistent care raspunde la intrebari fara sa
# trimita nicaieri documentele clientilor. Aceeasi cheie se poate pune in
# amandoua, dar alegerea ramane a lui.
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ── Asistentul din aplicatie (M13) ───────────────────────────────────────────
# Chatul care raspunde la „cat e de lucru?", „ce lipseste la X?", „cand e
# termenul?" si propune drumul catre ecranul potrivit.
#
#   rules     — motor determinist, fara nicio credentiala. Raspunde din aceleasi
#               interogari ca rutele obisnuite, cu permisiunile celui care
#               intreaba, si nu trimite nimic in afara retelei cabinetului.
#   anthropic — model de limbaj cu tool-calling peste ACELEASI unelte. Modelul nu
#               vede baza de date: primeste o lista scurta de unelte, alege ce
#               cheama, iar serverul executa sub permisiunile utilizatorului.
#               Cere ASSISTANT_API_KEY; fara ea, pornirea se opreste.
#
# Indiferent de motor, asistentul este **numai de citire**: nu aproba, nu
# respinge, nu trimite. Propune un link; omul il deschide. Iar linkurile vin din
# uneltele executate, nu din textul modelului.
ASSISTANT_PROVIDER=rules          # rules | anthropic
ASSISTANT_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
# Cate runde de unelte poate cere modelul inainte sa raspunda. Trei acopera
# „gaseste clientul, apoi vezi ce-i lipseste"; peste atat, un dialog care nu se
# termina costa bani fara sa dea un raspuns.
ASSISTANT_MAX_TOOL_ROUNDS=3

# ── OCR / AI, continuare ─────────────────────────────────────────────────────
PROMPT_VERSION=v1
# Praguri implicite; valorile efective se administrează din `system_settings` (§16).
CONFIDENCE_AUTO_THRESHOLD=0.90
CONFIDENCE_REVIEW_THRESHOLD=0.70
# Aprobarea fara verificare umana ramane oprita pana cand cineva o cere explicit.
AUTO_APPROVE_ENABLED=false
MAX_PROCESSING_ATTEMPTS=3
# Dupa cate minute un job ramas RUNNING se considera abandonat de un proces mort.
# `python -m app.cli recover-processing` il repune in coada.
PROCESSING_STALE_AFTER_MINUTES=15

# De cate secunde poate lipsi semnul de viata al workerului inainte ca
# `/health/workers` sa raspunda 503 si monitorizarea externa sa sune un om.
#
# Workerul continuu bate la fiecare tur; un tur gol dureaza ~2 secunde. Pragul
# trebuie sa fie mult mai mare, altfel alarma suna pentru un worker care doarme
# sau pentru unul ocupat cu un document greu. 90 = zeci de turi ratate la rand.
#
# PE O PLATFORMA SERVERLESS (Vercel) NU O PUNE. Acolo nu exista worker continuu:
# coada se executa prin cron, la 5 minute, iar aplicatia isi ridica singura
# pragul. O valoare pusa cu mana castiga oricum — inclusiv una gresita, care ar
# face alarma sa sune la fiecare verificare.
#
# `/health/ready` NU cade odata cu workerul, deliberat: ar scoate din rotatie
# toate instantele de API si ar transforma o problema de procesare intr-o cadere
# totala. Vezi docs/PRODUCTION_MONITORING.md.
WORKER_HEARTBEAT_TIMEOUT_SECONDS=90

# Din ce se derivă LUNA CONTABILĂ a unui document (ADR-008).
#
# `document_date` — data de pe document. Este cazul coplesitor si implicitul: o
# factura din 31 august primita pe 3 septembrie este a lunii august.
# `received_at`  — ziua in care a ajuns la cabinet. Se pune doar daca cabinetul
# lucreaza deliberat asa, si se schimba pentru toate documentele deodata.
#
# Fara data, nu se derivă nimic: o luna gresita este mai rea decat una absenta,
# fiindca se aproba fara sa se uite nimeni la ea.
REFERENCE_PERIOD_STRATEGY=document_date   # document_date | received_at

# ─── Preluarea documentelor din email ─────────────────────────────────────────
# IMPLEMENTATA (M10), pe aceeasi conexiune Microsoft ca OneDrive: vezi sectiunea
# de mai sus. Nu exista variabile separate — un singur consimtamant, doua surse.
# Ce dosare de email se citesc se alege din Administrare → Surse documente.
#
# Aici erau, pana acum, patru variabile din specificatia initiala
# (EMAIL_PROVIDER, MICROSOFT_CLIENT_ID, ...) pe care codul nu le-a citit
# niciodata. Un exemplu de configurare care enumera variabile inexistente este
# mai rau decat unul incomplet: cineva le pune si se intreaba de ce nu se
# intampla nimic.

# ─── WhatsApp (Faza 2) ────────────────────────────────────────────────────────
# NICIUN COD NU CITESTE VARIABILELE DE MAI JOS. Sunt aici ca plan, nu ca
# configurare: trimiterea pe WhatsApp nu este implementata. Le poti completa, dar
# nu se va intampla nimic.
#
# Fisierul asta condamna, cateva randuri mai sus, exact greseala de a enumera
# variabile pe care aplicatia nu le citeste. Marcajul e mai onest decat stergerea:
# planul ramane vizibil, iar nimeni nu pierde o dupa-amiaza adunand credentiale
# degeaba.
WHATSAPP_PROVIDER=none            # none | meta | twilio  (NEIMPLEMENTAT)
WHATSAPP_TOKEN=                   # NEIMPLEMENTAT
WHATSAPP_PHONE_NUMBER_ID=         # NEIMPLEMENTAT
WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # NEIMPLEMENTAT
WHATSAPP_APP_SECRET=              # NEIMPLEMENTAT

# ─── Notificări ───────────────────────────────────────────────────────────────
# Solicitarile de documente pot pleca acum din aplicatie, pe SMTP. Ca sa plece
# chiar, trebuie **amandoua**: comutatorul pornit si un server configurat. Unul
# fara celalalt produce un buton care esueaza la apasare, in loc de unul care
# spune dinainte ce lipseste.
#
# Implicit oprit, si nu din prudenta abstracta: un cabinet care importa o baza de
# test cu adrese reale ar scrie clientilor adevarati.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=                        # gol = trimiterea nu este configurata
SMTP_PORT=587                     # 587 cu STARTTLS; pentru 465 pune SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                        # gol = se foloseste SMTP_USER, care de obicei este chiar adresa
SMTP_STARTTLS=true

# Rezumatul zilnic catre cabinet — nu catre clienti. Comutator propriu, fiindca
# un cabinet poate vrea rezumatul fara sa lase aplicatia sa scrie clientilor.
# Se cheama o data pe zi, dimineata: GET /api/v1/internal/daily-digest, cu
# `Authorization: Bearer $CRON_SECRET`.
DAILY_DIGEST_ENABLED=false

# Reminderele catre CLIENTI, trimise de planificator:
# GET /api/v1/internal/reminders, cu `Authorization: Bearer $CRON_SECRET`.
# Pornit implicit — decizia s-a luat, cabinetul a hotarat ca aplicatia are voie
# sa scrie clientilor. Ce tine locul unui comutator oprit este
# NOTIFICATIONS_ENABLED de mai sus: fara SMTP configurat nu pleaca nimic, deci o
# instalare proaspata nu scrie nimanui.
#
# Se refera strict la ce pleaca SINGUR. Butonul „Trimite acum" din
# Comunicare -> Remindere merge si cu asta pe false: un om care apasa nu face
# automatizare. Regulile (cui, cat de des) stau in app/services/reminders.py.
CLIENT_REMINDERS_ENABLED=true

# ─── Cutii postale IMAP ───────────────────────────────────────────────────────
# Nu are variabile de mediu: cutiile se adauga din aplicatie, la
# Administrare -> Surse documente. Serverul, utilizatorul si parola stau in baza
# de date, parola criptata cu DRIVE_TOKEN_KEY -- deci fara acea cheie nu se
# poate adauga nicio cutie, iar ecranul o spune.
#
# La Gmail si la Microsoft este nevoie de o PAROLA DE APLICATIE, nu de parola
# contului: amandoua resping de mult IMAP cu parola obisnuita, iar mesajul lor de
# eroare nu spune asta.
IMAP_SYNC_BATCH=15                # cate mesaje se citesc dintr-o cutie pe bataie

# ─── Retenție (§64) ───────────────────────────────────────────────────────────
# NEIMPLEMENTATĂ. Nicio ștergere automată nu există în cod: nu rulează niciun job
# de retenție, iar `RETENTION_ENABLED=true` nu șterge nimic. Cele trei durate de
# mai jos nu sunt nici măcar citite — nu există câmpuri pentru ele în `Settings`.
#
# Marcajul, nu ștergerea, din același motiv ca la WhatsApp mai sus: planul rămâne
# vizibil. Iar fișierul acesta condamnă, cu două secțiuni mai devreme, exact
# greșeala de a enumera variabile pe care aplicația nu le citește — nu are voie
# să o facă el însuși în tăcere.
#
# Ce se șterge azi, și cum: nimic automat. Documentele se șterg logic, dintr-un
# ecran, de un om, cu urmă în jurnal.
RETENTION_ENABLED=false           # NEIMPLEMENTAT
RETENTION_DOCUMENTS_YEARS=10      # NEIMPLEMENTAT — niciun câmp în Settings
RETENTION_AUDIT_LOG_YEARS=5       # NEIMPLEMENTAT — niciun câmp în Settings
RETENTION_TEMP_FILES_DAYS=7       # NEIMPLEMENTAT — niciun câmp în Settings

# ─── Observabilitate (opțional) ───────────────────────────────────────────────
# NEIMPLEMENTATE. Logurile sunt structurate (structlog) si merg la stdout; nu
# exista inca export catre Sentry sau un colector OTLP.
SENTRY_DSN=                       # NEIMPLEMENTAT
OTEL_EXPORTER_OTLP_ENDPOINT=      # NEIMPLEMENTAT
